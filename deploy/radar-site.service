# systemd-юнит для сайта и кабинета: держит uvicorn в фоне и поднимает его заново,
# если процесс упал или сервер перезагрузился.
#
# Что подставить своё — два места в угловых скобках. Скобки убираются вместе с текстом
# внутри: было <путь-к-проекту>, стало /root/radar-zayavok.
#
# Как поставить на сервер (команды выполняет человек, не агент):
#   1. Скопировать этот файл в /etc/systemd/system/radar-site.service
#   2. systemctl daemon-reload — systemd перечитает файлы юнитов
#   3. systemctl enable radar-site — автозапуск после перезагрузки сервера
#   4. systemctl start radar-site — запустить сейчас
#   5. systemctl status radar-site — ожидаемая строка: Active: active (running)
#
# «Работает сейчас» и «переживёт перезагрузку» — два разных вопроса: start отвечает на
# первый, enable на второй. Проверить второй отдельно: systemctl is-enabled radar-site.

[Unit]
Description=Radar zayavok - sayt i kabinet
# Не пытаться стартовать раньше, чем на сервере поднимется сеть.
After=network.target

[Service]
Type=simple

# Пользователь, от имени которого работает сайт. На свежем VPS обычно root, но если вы
# завели отдельного пользователя — укажите его.
User=<пользователь>

# Папка с кодом, та, куда сделан git clone. Из неё же приложение читает .env: файл
# лежит рядом с кодом, в git его нет, на сервере вы создаёте его руками.
WorkingDirectory=<путь-к-проекту>

# Запуск через uvicorn из виртуального окружения проекта, а не из системного Python:
# путь к нему указываем полностью, потому что systemd не активирует окружение сам.
# Адрес 127.0.0.1 — приложение слушает только локально, наружу его выставляет nginx.
ExecStart=<путь-к-проекту>/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

# Упал — поднять снова, через три секунды. Без этого одна ошибка в коде оставит сайт
# лежать до того момента, когда вы случайно это заметите.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
