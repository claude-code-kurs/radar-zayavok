# systemd-юнит для юзербота: держит его работающим круглосуточно и поднимает заново
# после падения или перезагрузки сервера. Сделан по образцу radar-site.service,
# разница только в том, что запускается, и в том, что портов здесь нет — юзербот
# ничего не слушает, он сам ходит в Telegram.
#
# Что подставить своё — два места в угловых скобках. Скобки убираются вместе с текстом
# внутри: было <путь-к-проекту>, стало /root/radar-zayavok.
#
# Как поставить на сервер (команды выполняет человек, не агент):
#   1. Скопировать этот файл в /etc/systemd/system/radar-userbot.service
#   2. systemctl daemon-reload
#   3. systemctl enable radar-userbot — автозапуск после перезагрузки
#   4. systemctl start radar-userbot — запустить сейчас
#   5. systemctl status radar-userbot — ожидаемая строка: Active: active (running)
#   6. systemctl is-enabled radar-userbot — ожидаемый ответ: enabled
#
# Шестая команда не лишняя: «работает сейчас» и «переживёт перезагрузку» — два разных
# вопроса, и status отвечает только на первый.
#
# Перед первым запуском на сервере уже должны лежать файл сессии (переносится с
# компьютера, в git его нет никогда) и .env с ключами.

[Unit]
Description=Radar zayavok - userbot
After=network.target

[Service]
Type=simple

# Пользователь, от имени которого работает юзербот. Тот же, что у сайта.
User=<пользователь>

# Папка с кодом. Из неё же читаются .env, файл сессии и файл состояния state.json —
# все три лежат рядом с кодом и в репозиторий не попадают.
WorkingDirectory=<путь-к-проекту>

# Python из виртуального окружения проекта: systemd не активирует окружение сам,
# поэтому путь указываем полностью.
ExecStart=<путь-к-проекту>/.venv/bin/python userbot.py

# Юзербот работает в бесконечном цикле опроса. Если он всё же упал — поднять снова
# через десять секунд: сразу перезапускать смысла нет, обычная причина падения —
# обрыв связи с Telegram.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
